# =====================================================================
# Configuration du stockage S3 (Option A)
# =====================================================================
# Si ces variables sont définies, l'application utilisera le stockage S3.
# Sinon, elle utilise le dossier local "storage/images/" par défaut.

# Nom du Bucket S3 (ex: my-insurance-documents)
S3_BUCKET_NAME=

# Identifiants AWS / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# URL du point de terminaison (Optionnel - pour MinIO, Cloudflare R2, Scaleway, etc.)
# Exemples :
# MinIO local : http://localhost:9000
# Cloudflare R2 : https://<account_id>.r2.cloudflarestorage.com
# S3_ENDPOINT_URL=
